---
import { Picture } from "astro:assets";
---

<section class="hero-section min-h-screen bg-abricot-beige overflow-hidden">
    <div class="pt-10 max-w-6xl mx-auto">
        <div class="space-y-4">
            <h2
                id="work-in-progress"
                class="section-title animate-on-scroll text-gray font-ivymode text-4xl leading-none tracking-tight"
            >
                Work in Progress
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                <div class="card card-dash bg-base-100 animate-scale stagger-1 overflow-hidden">
                    <div class="card-body">
                        <h2 class="card-title">
                            Lorem ipsum dolor sit amet, consectetur adipiscing
                            elit sed do eiusmod tempor
                        </h2>
                        <div class="overflow-hidden rounded-lg">
                            <Picture
                                src="https://picsum.photos/seed/picsum/600/600"
                                alt="Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor"
                                width={600}
                                height={600}
                                class="transition-transform duration-500"
                            />
                        </div>
